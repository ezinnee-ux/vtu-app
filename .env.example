# ----------------------------------------------------
# NIGERIAN VTU APPLICATION ENVIRONMENT CONFIGURATION
# ----------------------------------------------------

# Database Connection (Default is SQLite for instant local dev; change to PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://username:password@localhost:5432/vtu_db?schema=public"

# Authentication & Session Security
JWT_SECRET="super-secret-vtu-production-key-change-in-production-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VTU Provider Integration Settings
# Set VTU_TEST_MODE to "false" when deploying with real Nigerian VTU credentials
VTU_TEST_MODE="true"
VTU_PROVIDER_NAME="GenericVTU"
VTU_API_BASE_URL="https://api.vtuprovider.com/v1"
VTU_API_KEY="vtu_api_key_placeholder"
VTU_API_SECRET="vtu_api_secret_placeholder"

# Payment Gateways (Paystack & Flutterwave)
# Get keys from https://dashboard.paystack.com and https://dashboard.flutterwave.com
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"

# Default Admin User (Seed Credentials)
ADMIN_DEFAULT_EMAIL="admin@quickvtu.ng"
ADMIN_DEFAULT_PASSWORD="AdminSecure2026!"
